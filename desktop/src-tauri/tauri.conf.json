{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kryptix",
  "version": "0.1.0",
  "identifier": "com.kryptix.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kryptix",
        "width": 460,
        "height": 500,
        "minWidth": 420,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Secure password and recovery phrase vault",
    "longDescription": "Kryptix is a secure, offline-first password manager and recovery phrase vault with strong encryption."
  }
}
